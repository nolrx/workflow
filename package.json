{
  "name": "ai-creative-studio",
  "version": "1.0.0",
  "description": "AI-powered creative platform",
  "private": true,
  "scripts": {
    "setup": "uv sync && cd frontend && npm install",
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "cd backend && source venv/bin/activate && uv run --active python -m backend.app",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "npm-run-all test:backend test:frontend",
    "test:backend": "uv run pytest",
    "test:frontend": "cd frontend && npm test",
    "lint": "npm-run-all lint:backend lint:frontend",
    "lint:backend": "uv run ruff check backend/",
    "lint:frontend": "cd frontend && npm run lint",
    "db:migrate": "cd backend && uv run alembic upgrade head",
    "db:revision": "cd backend && uv run alembic revision --autogenerate -m"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
