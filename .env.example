# Database
DATABASE_URL=postgresql://ai_studio:ai_studio_dev_2024@localhost:5432/ai_creative_studio

# Redis
REDIS_URL=redis://localhost:6379/0

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# AI Provider Configuration
# Capability-based routing: text generation and image generation are configured
# independently. AI_PROVIDER is the fallback provider for both capabilities.
AI_PROVIDER=gemini

# Text generation -> Claude (Anthropic) API
AI_TEXT_PROVIDER=claude
AI_TEXT_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=                 # Claude API key (or CLAUDE_API_KEY)
# AI_TEXT_MAX_TOKENS=32000         # Optional: max output tokens for text.
                                   #   Raise (e.g. 32000) for single-file HTML builds,
                                   #   which need more room than short text steps.
# AI_TEXT_BASE_URL=                # Optional: custom Claude API base URL
# AI_TEXT_READ_TIMEOUT=120         # Optional: max seconds between streamed chunks
# AI_TEXT_STREAM_RETRIES=2         # Optional: retries on mid-stream connection drops
# AI_TEXT_STREAM_RETRY_DELAY=2     # Optional: base backoff seconds between retries

# Image generation -> Panlaxy (OpenAI-compatible) image API
AI_IMAGE_PROVIDER=panlaxy
PANLAXY_BASE_URL=https://api.panlaxy.io/v1
PANLAXY_API_KEY=                   # Panlaxy API key
PANLAXY_IMAGE_MODEL=gpt-image-2    # gpt-image-1 | gpt-image-1.5 | gpt-image-2
PANLAXY_IMAGE_QUALITY=medium       # low | medium | high | auto
PANLAXY_IMAGE_SIZE=1024x1024       # e.g. 1024x1024 | 1536x1024 | 1024x1536
# PANLAXY_TIMEOUT=180              # Optional: request timeout (seconds)
# PANLAXY_MAX_RETRIES=0           # Optional: SDK retry count

# Shared / fallback (used by the gemini provider)
AI_API_KEY=
# AI_IMAGE_MODEL=imagen-3.0-generate-002
# AI_BASE_URL=                     # Optional: custom API base URL

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
