# Database
# DATABASE_URL is for bare-metal/dev runs. Under docker-compose the backend
# overrides it to reach the `postgres` service, assembled from POSTGRES_* below.
DATABASE_URL=postgresql://ai_studio:ai_studio_dev_2024@localhost:5432/ai_creative_studio

# Postgres container credentials — docker-compose reads these for the postgres
# service AND to build the backend's in-container DATABASE_URL. Keep all three
# consistent with DATABASE_URL above.
POSTGRES_USER=ai_studio
POSTGRES_PASSWORD=ai_studio_dev_2024
POSTGRES_DB=ai_creative_studio

# Redis
REDIS_URL=redis://localhost:6379/0

# SQLAlchemy connection pool (backend/config.py). Sized alongside GUNICORN_THREADS:
# every long-lived SSE stream holds a thread, so the pool must have headroom or
# normal requests starve. Raise together with the thread count / PG max_connections.
# DB_POOL_SIZE=20          # persistent connections kept open per worker
# DB_MAX_OVERFLOW=40       # extra connections allowed above pool_size under load
# DB_POOL_TIMEOUT=30       # seconds a request waits for a free connection before erroring
# SQLALCHEMY_DATABASE_URI= # fallback for DATABASE_URL (middleware layer only); normally leave unset

# MongoDB — stores editable system prompts (admin can tune them online).
# Optional for bare-metal dev: if Mongo is unreachable the app falls back to
# bundled default prompts (read-only). Under docker-compose the backend
# overrides MONGODB_URI to reach the `mongo` service.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_creative_studio
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000   # how long to wait for Mongo before
                                             # falling back to bundled default prompts

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# CORS — comma-separated list of allowed frontend origins (production only; dev
# is permissive). Set to the exact scheme+host(s) the SPA is served from.
# CORS_ORIGINS=https://worksflow.xyz,https://www.worksflow.xyz

# Gunicorn gthread pool size (single worker — see backend/gunicorn.conf.py). Each
# long-lived SSE stream (per-tab notification stream + each live agent-run watch +
# the 3 full-stack lanes) holds one thread for its lifetime, so a normal request
# can starve behind them at the default. Under docker-compose this is set to 64.
# GUNICORN_THREADS=16

# AI Provider Configuration
# Capability-based routing: text generation and image generation are configured
# independently. AI_PROVIDER is the fallback provider for both capabilities.
AI_PROVIDER=gemini

# Text generation -> Claude (Anthropic) API
AI_TEXT_PROVIDER=claude
AI_TEXT_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=                 # Claude API key (or CLAUDE_API_KEY) -> x-api-key
# --- Optional: route Claude through a third-party Anthropic-compatible gateway
# (e.g. zentao.panlaxy.io). AUTH_TOKEN is sent as Authorization: Bearer and is
# used INSTEAD OF ANTHROPIC_API_KEY (both set -> two auth headers -> 401).
# BASE_URL is the gateway ROOT, no /v1 suffix (the SDK + CLI append /v1/...).
# The TEXT provider and the in-container CODE-GEN agents can use the SAME gateway
# creds, or DIFFERENT keys/models per lane:
#
#   Text lane A — Anthropic-format model (a Claude model on the gateway), via the
#   anthropic SDK (POST /v1/messages):
#     AI_TEXT_PROVIDER=claude
#     AI_TEXT_AUTH_TOKEN=sk-...                    # Bearer (text lane key)
#     AI_TEXT_BASE_URL=https://zentao.panlaxy.io   # gateway ROOT (NOT .../v1)
#     # AI_TEXT_THINKING=auto   # auto(default)=adaptive-thinking on iff model is claude-*; on|off to force
#                               # (non-Claude gateway models reject the thinking param)
#     # ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro  # single-model gateways have no 'haiku'
#                               # tier; pin the background/fast model the SDK would otherwise request.
#   Text lane B — NON-Anthropic model served ONLY via OpenAI Chat Completions
#   (e.g. deepseek-v4-* on zentao.panlaxy.io, where /v1/messages 403s). Use the
#   OpenAITextProvider; AI_TEXT_BASE_URL MUST include /v1 (SDK appends /chat/completions):
#     AI_TEXT_PROVIDER=openai
#     AI_TEXT_MODEL=deepseek-v4-pro
#     AI_TEXT_AUTH_TOKEN=sk-...                        # Bearer == openai api_key
#     AI_TEXT_BASE_URL=https://zentao.panlaxy.io/v1    # WITH /v1
#   Code-gen agent lane (fe/be `claude` CLI in docker; INDEPENDENT key/model).
#   The claude CLI speaks ONLY /v1/messages. AGENT_ANTHROPIC_MODEL MUST be a model
#   the token can access (zentao only grants deepseek-v4-pro to this token; opus
#   etc. -> deterministic 403 "no access"). zentao's /v1/messages is also flaky
#   (~50% random 403 "HTTP node only allows access to inference API paths" as it
#   load-balances across mixed upstream nodes) and the claude CLI does NOT retry
#   403 -> a localhost retry-shim is auto-injected into the agent container to
#   retry ONLY that random 403 (see docker_env.ANTHROPIC_RETRY_PROXY_BOOTSTRAP):
#     AGENT_ANTHROPIC_AUTH_TOKEN=sk-...               # Bearer (agent lane key)
#     AGENT_ANTHROPIC_BASE_URL=https://zentao.panlaxy.io
#     AGENT_ANTHROPIC_MODEL=deepseek-v4-pro           # ANTHROPIC_MODEL inside the container (must be token-accessible)
#     # AGENT_ANTHROPIC_SMALL_MODEL=deepseek-v4-pro   # background/fast model (defaults to ^); a single-model gateway has no 'haiku'
#     # AGENT_GATEWAY_RETRY_403=0                      # disable the retry-shim (default on when a gateway base_url is set)
#     # ANTHROPIC_PROXY_MAX_RETRIES=12                 # retry-shim attempts per request (default 12)
#     # AGENT_ANTHROPIC_API_KEY=sk-...                 # x-api-key variant of the agent lane key (use INSTEAD of AUTH_TOKEN for official-API keys)
#     # ANTHROPIC_PROXY_PORT=8788                       # in-container port the retry-shim listens on (rarely changed)
#
# Shared fallback for BOTH lanes (used when the per-lane vars above are unset):
# ANTHROPIC_AUTH_TOKEN=sk-...                  # Bearer token for the gateway
# ANTHROPIC_BASE_URL=https://zentao.panlaxy.io # Gateway root (NOT .../v1)
# AI_TEXT_MAX_TOKENS=32000         # Optional: max output tokens for text.
                                   #   Raise (e.g. 32000) for single-file HTML builds,
                                   #   which need more room than short text steps.
# AI_TEXT_BASE_URL=                # Optional: custom Claude API base URL
# AI_TEXT_API_KEY=                 # Optional: capability-specific text key (else falls back to the provider key / AI_API_KEY)
# AI_TEXT_READ_TIMEOUT=120         # Optional: max seconds between streamed chunks
# AI_TEXT_STREAM_RETRIES=2         # Optional: retries on mid-stream connection drops
# AI_TEXT_STREAM_RETRY_DELAY=2     # Optional: base backoff seconds between retries
# AI_TEXT_OPENAI_RETRIES=2         # Optional: SDK retry count for the OpenAITextProvider lane

# Image generation -> OpenAI (ChatGPT) image API via the openai SDK.
# Verified: gpt-image-2 works through images.generate (size/quality, b64_json).
AI_IMAGE_PROVIDER=openai
AI_IMAGE_MODEL=gpt-image-2          # gpt-image-2 | gpt-image-1.5 | gpt-image-1
OPENAI_API_KEY=                    # ChatGPT / OpenAI API key (also used as image key)
# AI_IMAGE_API_KEY=                # Optional: capability-specific image key (else falls back to the provider key / AI_API_KEY)
# AI_IMAGE_BASE_URL=               # Optional: capability-specific image base URL
# OPENAI_BASE_URL=https://api.openai.com/v1   # Optional: custom OpenAI-compatible base URL
# OPENAI_IMAGE_QUALITY=medium      # low | medium | high | auto
# OPENAI_IMAGE_SIZE=1024x1024      # 1024x1024 | 1536x1024 | 1024x1536 | auto
# OPENAI_TIMEOUT=180               # Optional: request timeout (seconds)
# OPENAI_MAX_RETRIES=0             # Optional: SDK retry count

# Code UI preview thumbnails: seconds to wait between two successive generations,
# letting each image settle on disk before the next is (re)generated. 0 disables
# the wait; clamped to [0, 30]. Default 2.0.
# CODE_PREVIEW_SETTLE_SECONDS=2.0

# Preview/app-proxy session lifetime (seconds). On entry the one-shot ?token=
# access token is exchanged for a resource-scoped preview token pinned into the
# httponly preview cookies (/preview/<pid>/ + /app/<pid>/api); this is how long a
# left-open preview tab keeps authenticating past the 30-min access token. Default
# 43200 (12h). The main API still reads JWTs from headers only, never these cookies.
# CODE_PREVIEW_TOKEN_TTL=43200

# Alternative image provider -> Gemini (native image model via the gemini provider).
# NOTE: the gemini provider calls generateContent + response_modalities, so it needs
# a NATIVE gemini image model (imagen-* uses a different `predict` endpoint).
# AI_IMAGE_PROVIDER=gemini
# AI_IMAGE_MODEL=gemini-3.1-flash-image  # gemini-3.1-flash-image | gemini-2.5-flash-image

# Alternative image provider -> Panlaxy (OpenAI-compatible) image API.
# AI_IMAGE_PROVIDER=panlaxy
# PANLAXY_BASE_URL=https://api.panlaxy.io/v1
# PANLAXY_API_KEY=                   # Panlaxy API key
# PANLAXY_IMAGE_MODEL=gpt-image-2    # gpt-image-1 | gpt-image-1.5 | gpt-image-2
# PANLAXY_IMAGE_QUALITY=medium       # low | medium | high | auto
# PANLAXY_IMAGE_SIZE=1024x1024       # e.g. 1024x1024 | 1536x1024 | 1024x1536
# PANLAXY_TIMEOUT=180                # Optional: request timeout (seconds)
# PANLAXY_MAX_RETRIES=0             # Optional: SDK retry count

# Shared / fallback (used by the gemini provider). The gemini key is resolved in
# this order: AI_API_KEY -> GOOGLE_API_KEY -> GEMINI_API_KEY (first non-empty wins).
AI_API_KEY=
# GOOGLE_API_KEY=                  # Optional: gemini key alias (used if AI_API_KEY is unset)
# GEMINI_API_KEY=                  # Optional: gemini key alias (last in the fallback chain)
# AI_BASE_URL=                     # Optional: custom API base URL

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub integration (optional) — org-level GitHub App.
# Each Code session (CodeProject) auto-syncs its full-stack deliverables to a
# private repo under GITHUB_REPO_OWNER (one repo per session), one commit per
# completed run: frontend/ + backend/ (deploy-validated) + db/ + contract/ + docs/.
# After a successful deploy the platform forks a `dev` branch for secondary
# development and never overwrites it (main stays platform-owned).
# Leave GITHUB_APP_ID empty to disable (the auto-sync hook becomes a silent no-op).
# Register a GitHub App, install it on the target org, and grant it:
#   - Repository permissions -> Administration: Read & write  (create repos)
#   - Repository permissions -> Contents: Read & write         (push files + branches)
# GITHUB_APP_ID=
# Provide the PEM either inline (escape newlines as \n) OR via a file path.
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/app-private-key.pem
# GITHUB_APP_INSTALLATION_ID=          # Optional: pin the installation id (else auto-resolved)
# GITHUB_REPO_OWNER=                   # Target org/user login (else the installation account)
# GITHUB_API_BASE=https://api.github.com   # Override for GitHub Enterprise
# GITHUB_REPO_VISIBILITY=private       # private | public | internal
# GITHUB_REPO_PREFIX=                  # Optional repo name prefix, e.g. "studio-"
# GITHUB_DEV_BRANCH=dev                # Secondary-dev branch forked after deploy (never overwritten)
# GITHUB_PUSH_DIST=false               # Also commit the built frontend/dist/ output (off by default)

# Sandboxed agent images (Docker-out-of-Docker) — optional overrides.
# The backend shells out to `docker run` for two workflows; build the images with
# `docker compose --profile setup build`. In docker-compose the image names +
# TMPDIR (a host/container-shared work dir) are already wired; override here only
# for bare-metal or custom tags.
# FE_AGENT_IMAGE=fe-agent:latest             # code_frontend_project_generation (Claude Code CLI + Codex CLI)
# SLICER_AGENT_IMAGE=slicer-agent:latest     # code_figma_slice_generation (OpenAI Codex CLI)
# DOCKER_BIN=docker                          # docker client binary
# AGENT_CONTAINER_USER=                       # user the agent container runs as: node | match-host (host uid:gid) | unset (image default). match-host is ignored when the host is root.
# AGENT_WORKDIR_HOST=                          # host path of the shared work dir for the sibling agent's -v bind mount. Auto-detected from /proc mountinfo; set only if detection fails (bare-metal).
# --- Frontend PROJECT build (code_frontend_project_generation) ---
# Claude Code writes the multi-file project; when the UI needs REAL raster imagery
# it triggers the bundled `image-assets` skill, which shells out to the OpenAI
# Codex CLI to generate pictures via the image model (genimage.mjs -> gpt-image-2)
# into src/assets/. Codex reuses OPENAI_API_KEY (set above for image generation);
# OPENAI_IMAGE_MODEL / OPENAI_IMAGE_QUALITY / OPENAI_IMAGE_SIZE are passed through
# so generated assets match the platform's image settings. The asset lane is
# fail-soft: with no OPENAI_API_KEY the build still runs (no generated assets).
# FE_AGENT_TIMEOUT=720                        # claude generate phase budget; 0 = NO cap (run to completion, never killed→degraded)
# FE_AGENT_REPAIR_TIMEOUT=300                 # claude repair round budget; 0 = no cap
# FE_AGENT_TOTAL_TIMEOUT=2400                 # host-side backstop on the whole run; 0 = wait forever (pair with the two above)
# FE_CODEX_TIMEOUT=420                        # per gen-assets (Codex) call budget, in-container (kept finite: fail-soft, never blocks build)
# FE_AGENT_NPM_CACHE=                          # OFF by default. Set to a Docker volume name (e.g. fe-npm-cache) or host path to PERSIST the npm cache across runs (faster repeat installs + resilience to a flaky registry). npm install already uses --no-audit --no-fund --prefer-offline. VALIDATE with one real generation before relying on it: the in-container user must be able to write the mount (named volumes are root-owned — confirm npm_install.log shows no EACCES). BE has the same install flags; its cache mount is a follow-up.
# FE_GENIMAGE_TIMEOUT=180                     # per single image-API call budget, in-container
# FE_AGENT_NPM_TIMEOUT=240                    # in-container `npm install` budget (deterministic tool; kept finite)
# FE_AGENT_BUILD_TIMEOUT=180                  # in-container `npm run build` (vite/tsc) budget (deterministic; kept finite)
# FE_RUNTIME_TIMEOUT=90                       # headless browser runtime-smoke budget per verify round (Playwright)
# --- Backend PROJECT build + full-stack deploy (code_backend_project_generation / code_fullstack_deploy) ---
# The be-agent image WRITES the polyglot backend project AND runs a REAL native
# build at GENERATION time (install -> compile -> test -> package-verify + bounded
# AI self-heal) — this is where "verify the backend can be packaged" happens. It
# carries full toolchains (JDK21+Maven / Go / Python / Node + make) and runs the
# SAME ladder for the deploy-time self-heal. NOTE: the be-agent container has NO
# docker.sock, so generation does NATIVE builds only; the actual image packaging
# (docker build) happens at deploy time on the platform.
# BE_AGENT_IMAGE=be-agent:latest             # falls back to fe-agent:latest if unset
# BE_AGENT_TIMEOUT=1200                       # claude generate phase budget (project write); 0 = run to completion (recommended; never killed→empty)
# BE_AGENT_INSTALL_TIMEOUT=480                # gen ladder: dependency install (npm ci / pip / go mod / mvn resolve)
# BE_AGENT_BUILD_TIMEOUT_GEN=480              # gen ladder: native compile/build (tsc / py_compile / go build / mvn compile)
# BE_AGENT_TEST_TIMEOUT=300                   # gen ladder: unit + contract tests (npm test / pytest / go test / mvn test)
# BE_AGENT_PACKAGE_TIMEOUT=180                # gen ladder: package-verify (make package + Dockerfile static lint)
# BE_AGENT_GEN_REPAIRS=1                      # gen ladder: AI self-heal rounds after a red build/test (deploy has a 2nd ladder)
# BE_AGENT_REINFORCE=1                        # BMAD 2nd pass: after first-gen, before the build ladder, run claude again to turn every FR/NFR/M functional anchor into a real end-to-end impl (no stubs); 0 = off (single gen)
# BE_AGENT_REINFORCE_TIMEOUT=0               # reinforce pass claude budget; 0 = reuse BE_AGENT_TIMEOUT (0 = run to completion)
# BE_AGENT_REPAIR_TIMEOUT=900                 # one CLAUDE repair round budget (real build+iterate, gen AND deploy build-repair); 0 = no cap
# BE_CODEX_REPAIR_TIMEOUT=900                 # one CODEX comprehensive deploy-repair round budget (in-container, seconds); 0 = no cap
# BE_CODEX_REPAIR_FLAGS=exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check  # headless codex flags for the deploy 5xx repair (prompt fed on stdin → temp file)
# BE_AGENT_TOTAL_TIMEOUT=0                    # host backstop on the WHOLE generate run; 0 = wait forever (recommended; per-phase caps are the real guard). If set finite, it MUST exceed gen + reinforce + (install+compile+test+package)×(1+GEN_REPAIRS) + repair×GEN_REPAIRS + margin (~7200s for REPAIRS=1 + REINFORCE=1), else the host kills mid-build → empty product → wrong refund.
# APP_BUILD_REPAIRS=3                         # max deploy-time AI repair rounds after a failed docker build (was 1)
# APP_DEPLOY_REPAIR_ROUNDS=3                  # max POST-START comprehensive Codex repair rounds (database+runtime 5xx+interface, one pass/round, rebuild+swap+re-check); 0 = off; best-effort-proceed (only an unhealthy repaired image rolls back)
# APP_DEPLOY_ALWAYS_REPAIR=1                  # run the post-start repair ladder at least ONCE on EVERY deploy even with NO 5xx — a proactive FE↔BE alignment pass (reads the frontend source, fixes latent 2xx field/shape/pagination mismatches). A pass that changes nothing leaves the running container untouched; a pass that would regress a healthy app is reverted. Set 0 to restore defect-only repair. Note: adds one Codex pass (minutes) per deploy.
# APP_BUILD_TIMEOUT=1200                      # per `docker build` of the generated backend image (seconds)
# APP_HEALTH_TIMEOUT=90                       # GET /health readiness window after the container starts
# APP_SMOKE_TIMEOUT=15                        # deploy CI smoke: per-endpoint GET timeout (only a 5xx rolls back; conn-timeout tolerated)
# APP_SMOKE_MAX_ENDPOINTS=3                   # deploy CI smoke: how many idempotent no-param contract GET endpoints to sample (+ /health)
# --- Deploy runtime wiring (the generated app's long-lived container) ---
# Under docker-compose APP_NETWORK / APP_BACKEND_PORT are already set; override only for bare-metal.
# APP_NETWORK=worksflow-net                   # docker network the generated backend container joins (reached by name)
# APP_BACKEND_PORT=8080                        # in-container port the generated backend listens on (injected as PORT)
# APP_CONTAINER_MEM=512m                       # memory cap for each deployed app container
# APP_DB_SSLMODE=disable                       # sslmode pinned into the injected DATABASE_URL (Go lib/pq defaults to require and crash-loops against a non-SSL shared PG)
# APP_HEALTH_PATH=/health                      # readiness path probed after the container starts
# --- Deploy DB schema safety (see docs; generated apps self-migrate) ---
# APP_PREAPPLY_INIT_SQL=0                       # 1 = pre-apply the middleware init.sql before first boot (default OFF: start from an empty DB and let the app migrate; init.sql is only a recovery fallback)
# APP_SCHEMA_RECONCILE_MAX=500                  # max columns the post-deploy reconciler will add/widen against the live DB (only adds/widens, never drops/narrows)
# APP_SCHEMA_RECONCILE_TABLES=200               # max tables the reconciler inspects
# --- Deploy first-screen + integration-test gates ---
# APP_FIRST_SCREEN_PROBE=1                      # 1 = advisory first-screen check after deploy (does the app render data?); does not roll back
# APP_FIRST_SCREEN_TIMEOUT=15                   # per-request seconds for the first-screen probe
# APP_ITEST_TIMEOUT=15                          # per-request seconds for the FE↔BE integration-test gate
# APP_ITEST_MAX_TESTS=14                        # cap on the executed AI-distilled test plan
# APP_ITEST_FE_DIGEST_CHARS=14000               # how much of the frontend's API-calling source is fed to the test-plan model
# --- Deploy AI-repair input caps ---
# APP_FE_REF_MAX_FILE=524288                    # 512KB: per-file cap when handing frontend source to the repair agent as reference
# APP_FE_REF_MAX_TOTAL=8388608                  # 8MB: total cap for that frontend reference bundle
# APP_REPAIR_MAX_FILE=2097152                   # 2MB: per-file cap when the deploy-repair agent reads a backend file
# --- Deployed-app demo seed (self-seeded on an empty DB so the first screen isn't blank; see docs/deploy-first-screen-seed) ---
# APP_SEED_DEMO_EMAIL=demo@example.com
# APP_SEED_DEMO_PASSWORD=Demo1234!
# APP_SEED_DEMO_PHONE=13800000000
# APP_SEED_DEMO_OTP=000000
# --- Generation quality: verify->repair gate + eval framework (P0-B) ---
# The FE/BE project workflows run a verify->repair loop: deterministic house-rules
# linter + runtime browser smoke (FE) + a skeptical rubric evaluator, combined into
# ONE blocking decision that drives bounded repair. Tune + measure it here.
# CODE_VERIFY_MAX_ROUNDS=2                     # max repair rounds per run (0 = verify-only, no repair). Total verify passes = this + 1.
# CODE_REVIEW_PANEL=1                          # reviewers in the consensus panel (rotating lenses → majority vote). >1 = real consensus (multiplies the per-review charge below).
# CODE_QUALITY_MIN_SCORE=                      # A1 score gate (unset/empty = OFF → behaviour unchanged). When set, a final weighted_score (0~5) below this ALSO blocks → triggers a repair round. CALIBRATE with scripts/eval_review.py first (set near the good-cluster floor; broken-but-pretty apps can score high, so this is a secondary net to the objective blockers).
# CODE_QUALITY_MIN_FUNCTIONALITY=              # optional per-dimension floor (0~5) — functionality usually separates working/broken better than the overall score. Also CODE_QUALITY_MIN_DESIGN / _ORIGINALITY / _CRAFT.
# CODE_REPAIR_PIVOT=0                          # A3 refine→pivot: when set (1), a repair round whose rubric score didn't improve escalates the brief from "only fix" to "may refactor this module". Default off; dormant until the judge produces a score trend.
# --- Acceptance-driven iteration (P-A) + incremental build (P-B) ---
# Iterate the FE/BE project build until every FUNCTIONAL feature passes (not just
# "nothing blocking"), capped by a round budget with an early stop when coverage
# stalls. All default OFF (behaviour byte-identical) — see docs/code-iterative-generation.md.
# CODE_ITERATE_TO_ACCEPTANCE=0                 # 1 = keep repairing while functional features remain unmet
# CODE_ITERATE_MAX_ROUNDS=6                    # repair-round budget when acceptance iteration is on
# CODE_ITERATE_STALL=2                         # stop early if functional coverage gains nothing for N rounds
# CODE_BUILD_BATCHES=1                          # >1 splits the build into N incremental waves (per-batch focus); reuses the edit mode. Raise (3~4) for large mid-back-office builds that time out as a single pass.
# PRICE_CODE_PROJECT_REVIEW=0                  # credits per evaluator call (folded-in per call; a panel of N costs N×). 0 = free, like the rest of Code.
#
# Offline eval harness (no user credits — runs on the .env text-lane key):
#   uv run python scripts/eval_review.py [--panel 3] [--lane backend] [--persist]
#   uv run python scripts/harness_ablation.py        # which gate components are load-bearing
# Online trend (owner-scoped; admins add ?scope=all): GET /api/code/quality/trends?lane=&window_days=
# --- Figma SLICE export (code_figma_slice_generation) ---
# Codex CLI uses OPENAI_API_KEY (set above for image generation — reused here).
# SLICER_CODEX_FLAGS=exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check --json
# CODEX_TIMEOUT=300                          # per-analysis budget (seconds, in-container)
# SLICER_TOTAL_TIMEOUT=420                   # host backstop if the container never exits
# PRICE_CODE_FIGMA_SLICE=0                   # credits per slice run (0 = free, like the rest of Code)

# =============================================================================
# Dev Mode — interactive development workbench (docs/code-dev-mode.md)
# A long-running dev container per session (npm run dev + HMR) driven by
# conversational turns, with a two-pane live preview. All defaults are baked in;
# override here only to tune resources / timeouts. CODE_DEV_MODE=1 is the feature
# flag (set 0 to disable Dev Mode entirely).
# =============================================================================
# CODE_DEV_MODE=1                              # 0/false disables the Dev Mode feature
# --- Frontend dev container (backend/services/code/dev_service.py) ---
# DEV_MODE_VITE_PORT=5173                      # in-container Vite dev-server port
# DEV_MODE_CONTAINER_MEM=1024m                 # memory cap for the frontend dev container
# DEV_MODE_HMR_CLIENT_PORT=443                 # HMR websocket client port advertised to the browser (behind TLS proxy)
# DEV_MODE_HMR_PROTOCOL=wss                    # HMR websocket protocol (ws | wss)
# DEV_MODE_INSTALL_TIMEOUT=600                 # first `npm install` budget when the container boots
# DEV_MODE_START_TIMEOUT=120                   # wait for the dev server to come up
# DEV_MODE_TURN_TIMEOUT=0                       # per conversational turn (docker exec claude) budget; 0 = run to completion
# DEV_MODE_IDLE_REAP_SECONDS=3600              # reap an idle dev container after N seconds of no activity
# DEV_MODE_MAX_FILE_BYTES=2000000              # per-file cap when snapshotting the project workspace (2MB)
# DEV_MODE_MAX_TOTAL_BYTES=48000000            # total workspace snapshot cap (48MB)
# DEV_MODE_DIST_MAX_FILE_BYTES=16000000        # per-file cap when harvesting the built dist (16MB)
# DEV_MODE_DIST_MAX_TOTAL_BYTES=64000000       # total built-dist cap (64MB)
# DEV_MODE_LEDGER_CHARS=4000                   # chars of the context ledger rendered into each turn prompt
# DEV_MODE_MAX_PARALLEL=4                       # max concurrent lanes for a parallel (multi-task) dev turn
# --- Backend dev container (backend/services/code/dev_backend_service.py) ---
# DEV_MODE_BE_PORT=8080                         # in-container backend port (defaults to APP_BACKEND_PORT)
# DEV_MODE_BE_CONTAINER_MEM=1024m               # memory cap for the backend dev container
# DEV_MODE_BE_START_TIMEOUT=180                 # wait for the backend dev server to come up
# DEV_MODE_BE_INSTALL_TIMEOUT=600               # backend dependency install budget
# DEV_MODE_BE_TURN_TIMEOUT=0                     # per backend dev turn budget; 0 = run to completion
# --- Dev container self-heal / reaper (backend/services/code/dev_maintenance.py) ---
# DEV_MODE_MAINTENANCE_INTERVAL=300             # background maintenance sweep interval (seconds)
# DEV_MODE_MAX_HEAL=3                            # max auto-heal attempts on a wedged dev container
# DEV_MODE_CRASHLOOP_RESTARTS=3                  # restart budget before a crash-looping container is given up on
# --- Dev turn / backlog planner ---
# CODE_DEV_TURN_REPAIR=1                         # 1 = run a verify->repair pass inside each dev turn (0 disables)
# CODE_DEV_PLANNER_TIMEOUT=100                   # backlog-planner model call budget (seconds)
# CODE_DEV_PLAN_STUCK_SECONDS=180               # treat a plan draft with no progress for N seconds as stuck
# --- Dev Sprint scheduler (multi-turn task board; docs: dev-sprint) ---
# CODE_DEV_TASK_MAX_RETRIES=2                    # per-task retry budget before it's marked blocked
# CODE_DEV_SPRINT_MAX_TURNS=24                   # hard cap on scheduled turns in one sprint run
# CODE_DEV_SPRINT_STALL=4                         # stop early if the board makes no progress for N turns
# CODE_DEV_SPRINT_MAX_RUN_FAILURES=2             # give up after N consecutive turn-run failures
# CODE_DEV_SPRINT_MAX_WAIT_ROUNDS=60             # max polling rounds while waiting on an in-flight turn
# --- Dev -> release promotion (backend/services/code/deploy_service.py, frontend_dist_builder.py) ---
# Deploy from the latest source snapshot INCLUDING dev-mode edits, and warm-build
# the frontend dist while stopping the dev container so the deploy hits a fresh cache.
# CODE_DEPLOY_FROM_DEV=1                          # 0 = deploy the pre-dev generated snapshot instead of dev edits
# CODE_DEV_DIST_BUILD_TIMEOUT=600                # warm frontend-dist build budget (seconds)
# CODE_DEV_DIST_MAX_FILE_BYTES=16000000          # per-file cap when caching the warm-built dist (16MB)
# CODE_DEV_DIST_MAX_TOTAL_BYTES=64000000         # total cap for the cached dist (64MB)

# =============================================================================
# Figma export / slice (backend/services/code/figma/*)
# =============================================================================
# FIGMA_TOKEN_KEY=                               # 32-byte urlsafe-base64 Fernet key to persist encrypted Figma PATs across restarts. Unset = an ephemeral key (tokens don't survive a restart; users re-paste the PAT).
# FIGMA_MAX_FRAMES=24                            # max frames pulled into a single Figma import/export

# =============================================================================
# Credit pricing (backend/services/pricing.py) — every AI-consuming op is metered
# here. ALL default to 0 (free); set a PRICE_* to re-enable metering with no code
# change. Values are credits; negatives are clamped to 0.
# =============================================================================
# PRICE_CODE_FULL=0                              # full code workflow (requirements->flow->docs->style->preview->publish)
# PRICE_CODE_CONTEXT_VERIFY=0                    # per AI context-consistency gate (folded in per call)
# PRICE_CODE_PROJECT_REVIEW=0                    # per acceptance/quality evaluator call (a panel of N costs N×)
# PRICE_CODE_FRONTEND_PROJECT=0                  # agentic frontend PROJECT generation (sandboxed coding CLI)
# PRICE_CODE_SECTION_REVISE=0                    # inline section (partial) revision of a confirmed document
# PRICE_CODE_FIGMA_EXPORT=0                      # HTML -> Design IR export (model call)
# PRICE_CODE_FIGMA_SLICE=0                       # Figma SLICE export (Codex CLI -> editable Design IR)
# PRICE_CODE_CANVAS_RUN=0                        # remix canvas run (up-front reservation)
# PRICE_CODE_CANVAS_NODE=0                       # per agent-node folded into a canvas run
# PRICE_CODE_CONTRACT_SYNTHESIS=0                # full-stack: shared OpenAPI contract synthesis
# PRICE_CODE_BACKEND_PROJECT=0                   # full-stack: agentic backend PROJECT generation
# PRICE_CODE_MIDDLEWARE=0                        # full-stack: middleware provisioning (schema/migrations/seed)
# PRICE_CODE_FULLSTACK_DEPLOY=0                  # full-stack: atomic deploy run
# PRICE_CODE_FULLSTACK_ITEST=0                   # deploy-time FE↔BE integration test (folded in per call)
# PRICE_CODE_ITERATION_ANALYSIS=0               # secondary-dev (二次开发) impact analysis + plan
# PRICE_CODE_DEV_TURN=0                          # per interactive Dev Mode turn (code_dev_turn)
# PRICE_CODE_DEV_SPRINT=0                        # dev sprint orchestrator coordination (each turn bills itself)
# PRICE_CODE_DEV_BACKLOG_PLANNER=0              # backlog planner model call
# PRICE_CODE_DEV_ASSET_IMAGE=0                   # per REQUIRED output image generated inside a dev turn

# --- Graceful platform redeploy / ops control (scripts/deploy-backend.sh, make redeploy) ---
# Shared token authorizing the drain/undrain/status ops endpoints
# (POST/GET /api/admin/lifecycle/*, sent in the X-Deploy-Token header). UNSET =
# those endpoints are disabled (403); a graceful redeploy then skips draining but
# in-flight runs still resume after the swap. Set a long random value in prod.
# DEPLOY_CONTROL_TOKEN=
# AGENT_MAX_RESUME_ATTEMPTS=3                 # max restart-resumes of one run before it's failed (crash-loop guard)

# --- Agent runtime concurrency (throughput tuning) ---
# AGENT_MAX_WORKERS=16                        # process-wide ThreadPoolExecutor size = max runs executing at once
#                                             # across ALL users; excess runs queue. Each slot may spin up a Docker
#                                             # build (fe-agent/be-agent), so size to the host's CPU/memory — too
#                                             # high risks OOM / slow concurrent builds. Full-stack fans out 3 runs/project.
# AGENT_MAX_CONCURRENT_RUNS=12                # per-user active-run cap (queued+running+paused); over it -> 429
#                                             # CONCURRENCY_LIMIT. Must stay >= 3 (full-stack trio) with headroom;
#                                             # keep in step with AGENT_MAX_WORKERS.
